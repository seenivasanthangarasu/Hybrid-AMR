# ==============================================================================
# Hybrid-AMR Environment Profile: NVIDIA Jetson Orin Nano
# Hardware: 6-Core Arm Cortex-A78AE / NVIDIA Ampere GPU / Ubuntu 24.04 / ROS 2 Jazzy
# ==============================================================================
PLATFORM_NAME=jetson-orin-nano
SOC_MODEL=NVIDIA_Orin_Nano_ARM64
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/opt/amr/config/fastdds_udp.xml

# Device Paths (Normalized /dev/amr_* layer identical via host udev rules)
DEVICE_SABERTOOTH=/dev/amr_sabertooth
DEVICE_ENCODER=/dev/amr_encoder
DEVICE_LIDAR=/dev/amr_lidar
DEVICE_IMU=/dev/amr_imu
DEVICE_GPS=/dev/amr_gps
DEVICE_CAMERA=/dev/amr_camera

# Hardware GPIO Interface (Jetson 40-pin expansion header GPIO controller)
# On Jetson Orin Nano, the 40-pin GPIO chip corresponds to tegra-gpio or gpiochip1
RADIO_GPIO_CHIP=gpiochip1
RADIO_CH1_PIN=12
RADIO_CH2_PIN=13

# Future NVIDIA Hardware Acceleration (NVIDIA Container Runtime)
# DOCKER_RUNTIME=nvidia
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
