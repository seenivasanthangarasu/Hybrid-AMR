# ==============================================================================
# Hybrid-AMR Environment Profile: Thundercomm Rubik Pi 3
# Hardware: Qualcomm QCS6490 Octa-Core ARM64 / Ubuntu 24.04 / ROS 2 Jazzy
# ==============================================================================
PLATFORM_NAME=rubik-pi-3
SOC_MODEL=Qualcomm_QCS6490_ARM64
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/opt/amr/config/fastdds_udp.xml

# Device Paths (Normalized /dev/amr_* layer)
DEVICE_SABERTOOTH=/dev/amr_sabertooth
DEVICE_ENCODER=/dev/amr_encoder
DEVICE_LIDAR=/dev/amr_lidar
DEVICE_IMU=/dev/amr_imu
DEVICE_GPS=/dev/amr_gps
DEVICE_CAMERA=/dev/amr_camera

# Hardware GPIO Interface (HOT RC DS-600 Radio Receiver on Qualcomm TLMM)
RADIO_GPIO_CHIP=gpiochip4
RADIO_CH1_PIN=8
RADIO_CH2_PIN=24
