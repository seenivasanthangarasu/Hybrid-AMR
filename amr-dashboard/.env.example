VITE_ROSBRIDGE_URL=ws://localhost:9090
VITE_WEB_VIDEO_URL=http://localhost:8080

# HTTP URL serving robot mesh files (STL/DAE) for the URDF 3D widget.
# rosbridge (VITE_ROSBRIDGE_URL) is a WebSocket endpoint and cannot serve
# these — this must point at a real static file server / package-http
# resource server. Leave unset to disable the URDF widget's mesh loading
# (it will render the scene without robot geometry rather than fail
# silently). See docs/remediation/spec.md REQ-04.
# VITE_MESH_SERVER_URL=http://localhost:8000/
