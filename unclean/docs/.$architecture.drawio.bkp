        <mxCell id="gap3" value="&#9888; GAP: conflicting lidar frames.&#10;static TF: laser_frame @ z=0.02&#10;URDF: lidar_link_1 @ (0.034,0,0.1771)&#10;Wheel joints type='fixed' yet&#10;/joint_states publishes positions&#10;&#8212; wheels never visually animate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=8;fillColor=#FFE6E6;strokeColor=#FF0000;dashed=1;fontColor=#CC0000;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1240" y="390" width="260" height="120" as="geometry" /></mxCell>

        <!-- ===================== 4. LOCALIZATION ===================== -->
        <mxCell id="loc1" value="slam_toolbox&#10;online_async (mapping)  /  localization (against saved map)&#10;Ceres Solver backend &#8212; SPARSE_NORMAL_CHOLESKY / SCHUR_JACOBI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="340" y="520" width="560" height="70" as="geometry" /></mxCell>

        <!-- ===================== 5. SUPERVISOR / BRINGUP ===================== -->
        <mxCell id="sup1" value="hybrid_manager&#10;(hybrid_navigation package)&#10;GPS &#8596; SLAM state-machine supervisor&#10;spawns nodes via subprocess.Popen('ros2 ...')" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="sup2" value="indoor_amr_launch.py&#10;(indoor_amr package)&#10;MAPPING bringup&#10;(staggered TimerAction sequence)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="340" y="635" width="260" height="105" as="geometry" /></mxCell>
        <mxCell id="sup3" value="navigation.launch.py&#10;(rock_bringup package)&#10;LOCALIZATION bringup&#10;(runs against a pre-built saved map)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="640" y="635" width="260" height="105" as="geometry" /></mxCell>

        <mxCell id="gap1" value="&#9888; GAP: hybrid_manager never publishes /robot_mode &#8212; dashboard's INDOOR/OUTDOOR view switch always falls back to OUTDOOR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=8;fillColor=#FFE6E6;strokeColor=#FF0000;dashed=1;fontColor=#CC0000;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="940" y="635" width="260" height="105" as="geometry" /></mxCell>

