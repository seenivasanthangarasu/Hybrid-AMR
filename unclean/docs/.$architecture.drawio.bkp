        <mxCell id="br2" value="web_video_server&#10;MJPEG over HTTP :8080" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#D4E1F5;strokeColor=#37A76F;" vertex="1" parent="1"><mxGeometry x="400" y="920" width="320" height="80" as="geometry" /></mxCell>

        <!-- ===================== 8. DASHBOARD ===================== -->
        <mxCell id="dash0" value="8 &#183; OPERATOR DASHBOARD &#8212; amr-dashboard  (React 18.3 + Vite 5.3 + TailwindCSS 3.4), served on :5173" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#FFF9E6;strokeColor=#D6B656;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#8a6d00;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1780" height="380" as="geometry" /></mxCell>

        <mxCell id="dash1" value="RosConnectionService.js&#10;roslibjs singleton &#8212; topic cache,&#10;getTopic / getService / getActionClient" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="70" y="1090" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="dash2" value="RobotCommandService.js&#10;publishes operator commands&#10;(e-stop, mission goal, cmd_vel zero)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="70" y="1165" width="340" height="65" as="geometry" /></mxCell>
        <mxCell id="gap2" value="&#9888; GAP: /mission_state_cmd, /emergency_stop,&#10;/mission_goal (amr_msgs &#8212; package does not exist),&#10;/navigate_to_pose (nav2_msgs) are published but have&#10;NO ROS-side subscriber. Nav2 is not deployed in this workspace." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=8;fillColor=#FFE6E6;strokeColor=#FF0000;dashed=1;fontColor=#CC0000;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="70" y="1240" width="340" height="150" as="geometry" /></mxCell>

        <mxCell id="dash3" value="React Hooks&#10;&#8226; useRosConnection &#183; useRosTopic (base primitive)&#10;&#8226; useOdometry &#8592; /odom&#10;&#8226; useGps &#8592; /fix&#10;&#8226; useLaserScan &#8592; /scan&#10;&#8226; useOccupancyGrid &#8592; /map&#10;&#8226; useTF &#8592; /tf, /tf_static&#10;&#8226; useRobotMode &#8592; /robot_mode (defaults OUTDOOR)&#10;&#8226; useCameraFeed (auto-detect topic)&#10;&#8226; useUrdfViewer &#8592; /robot_description" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="430" y="1090" width="430" height="300" as="geometry" /></mxCell>

        <mxCell id="dash4" value="Views / Components&#10;&#8226; GpsMapView &#8212; Leaflet + react-leaflet + OSM tiles&#10;&#8226; SlamView &#8212; Canvas2D render of OccupancyGrid&#10;&#8226; LidarView &#8212; Canvas2D polar plot + safety zone&#10;&#8226; CameraView &#8212; plain &lt;img&gt; MJPEG (bypasses useCameraFeed)&#10;&#8226; UrdfWidget &#8212; ros3d.js + three.js (UMD, window.THREE)&#10;&#8226; MissionPlanner &#183; ControlPanel &#183; StatusPanel&#10;&#8226; Header &#183; PreviewPanel &#183; NoDataBadge &#183; GpsPreviewMap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="880" y="1090" width="460" height="300" as="geometry" /></mxCell>

        <mxCell id="dash5" value="App.jsx + MissionProvider (React Context)&#10;&#10;mainView = 'auto' by default:&#10;  mode === 'INDOOR' &#8594; SlamView&#10;  else &#8594; GpsMapView&#10;(any preview click pins the view;&#10; a mode change resets pin to auto)&#10;&#10;TailwindCSS 'deck' dark theme&#10;(amber / cyan / green / red / violet signal colors)&#10;JetBrains Mono / IBM Plex Mono / Inter fonts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#FFFFFF;strokeColor=#D6B656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1360" y="1090" width="440" height="300" as="geometry" /></mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="EXTERNAL LIBRARIES, FRAMEWORKS &amp; TOOLCHAIN&#10;&#10;Core: ROS 2 Jazzy Jalisco (Ubuntu 24.04) &#183; colcon &#183; ament_python / ament_cmake &#183; rclpy &#183; rclcpp &#183; tf2_ros &#183; sensor_msgs &#183; nav_msgs &#183; geometry_msgs &#183; std_msgs &#183; launch / launch_ros &#183; xacro &#183; robot_state_publisher &#183; joint_state_publisher(+gui) &#183; slam_toolbox (Ceres Solver) &#183; YDLidar-SDK (C++) &#183; ublox_gps &#183; rosbridge_server &#183; web_video_server &#183; pyserial&#10;&#10;Simulation: Gazebo (gz sim) &#183; ros_gz_sim &#183; ros_gz_bridge          Visualization: RViz2 &#183; mapviz (Qt5, vendored, unused)&#10;&#10;Dashboard (amr-dashboard): React 18.3 &#183; Vite 5.3 &#183; TailwindCSS 3.4 + PostCSS + Autoprefixer &#183; roslibjs 1.4.1 &#183; Leaflet 1.9.4 + react-leaflet 4.2.1 (OpenStreetMap) &#183; ros3d 1.1.0 + three.js 0.160 &#183; react-grid-layout 1.4.4 (declared dependency, never imported)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="1780" height="180" as="geometry" /></mxCell>

