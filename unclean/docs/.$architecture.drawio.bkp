        <mxCell id="hw4" value="Depth Camera (assumed)&#10;RealSense-style, referenced only&#10;in URDF &#8212; no driver package&#10;found in this workspace" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="260" height="90" as="geometry" /></mxCell>

