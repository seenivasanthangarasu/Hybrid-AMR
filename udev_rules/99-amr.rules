# ==============================================================================
# 99-amr.rules — Persistent, conflict-free device symlinks for Hybrid-AMR
# Target Common Device Namespace: /dev/amr_*
# ==============================================================================

# 1. ESP32-S3 Wheel Encoders (QinHeng CH343 CDC-ACM & Silicon Labs CP2102N fallback)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B8F128275", MODE:="0666", GROUP:="dialout", SYMLINK+="amr_encoder esp32 esp"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="a8f8c998665df01189fd5e401045c30f", MODE:="0666", GROUP:="dialout", SYMLINK+="amr_encoder esp32 esp"

# 2. Sabertooth 2x32 Motor Controller (Dimension Engineering)
SUBSYSTEM=="tty", ATTRS{idVendor}=="268b", ATTRS{idProduct}=="0201", ATTRS{serial}=="160091F3C484", MODE:="0666", GROUP:="dialout", SYMLINK+="amr_sabertooth sabertooth amr_motors"

# 3. YDLIDAR G4 Laser Scanner (Silicon Labs CP2102)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="0001", MODE:="0666", GROUP:="dialout", SYMLINK+="amr_lidar lidar ydlidar"

# 4. Hiwonder GNSS / GPS (CH340 Serial on Hub Port 1-2.2)
SUBSYSTEM=="tty", KERNELS=="*-[12].2", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0666", GROUP:="dialout", SYMLINK+="amr_gps hiwonder_gps gps"

# 5. Hiwonder 9-DOF IMU (CH340 Serial on Hub Port 1-2.3)
SUBSYSTEM=="tty", KERNELS=="*-[12].3", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0666", GROUP:="dialout", SYMLINK+="amr_imu hiwonder_imu esp-imu"

# Universal fallback for USB serial and GPIO permissions
KERNEL=="ttyUSB*", MODE:="0666", GROUP:="dialout"
KERNEL=="ttyACM*", MODE:="0666", GROUP:="dialout"
KERNEL=="gpiochip*", MODE:="0666", GROUP:="gpio"

# 6. Logitech C270 HD 720p Webcam
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0825", ATTR{index}=="0", MODE:="0666", GROUP:="video", SYMLINK+="amr_camera logi_cam video_cam"
